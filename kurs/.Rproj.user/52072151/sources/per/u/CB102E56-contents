#functions
polinom <- function(data_x, data_y){
  x = matrix(c(rep(1, length(data_x)), data_x), ncol = 2)
  y = matrix(data_y, ncol = 1)
  a1 <- t(x) %*% y
  a2 <- solve(t(x) %*% x)
  w = t(a1) %*% a2
}

graph <- function(ind1, ind2, xl = "x", yl = "y", xli = NULL, yli = NULL){
  t = tab[c(ind1, ind2)]
  t = t[t[[1]] != 0, ]
  t = t[t[[2]] != 0, ]
  t <- lapply(t, log)
  plot(t[[1]], t[[2]],
       xlab = xl,
       ylab = yl,
       xlim = xli,
       ylim = yli)
  x = seq(min(t[[1]]), max(t[[1]]) + 1, 0.1)
  y = matrix(c(rep(1, length(x)), x), ncol = 2)
  lines(x, polinom(t[[1]], t[[2]]) %*% t(y), col = "green")
}

