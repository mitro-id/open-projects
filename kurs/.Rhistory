xlim = xli,
ylim = yli)
x = seq(0, max(t[[1]]), 0.1)
y = rep(1, length(x))
for(i in 1:pow)
y = append(y, x**i)
y = matrix(y, ncol = pow + 1)
lines(x, polinom(t[[1]], t[[2]], pow) %*% t(y), col = "green")
}
