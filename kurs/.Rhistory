graph <- function(ind1, ind2, xl = "x", yl = "y", xli = NULL, yli = NULL, pow = 1){
t = tab[c(ind1, ind2)]
t = t[t[[1]] != 0, ]
t = t[t[[2]] != 0, ]
t <- lapply(t, log)
plot(t[[1]], t[[2]],
xlab = xl,
ylab = yl,
xlim = xli,
ylim = yli)
x = seq(min(t[[1]]), max(t[[1]]) + 1, 0.1)
y = rep(1, length(x))
for(i in 1:pow)
y = append(y, x**i)
y = matrix(y, ncol = pow + 1)
lines(x, polinom(t[[1]], t[[2]], pow) %*% t(y), col = "green")
}
polinom <- function(data_x, data_y, pow){
x = rep(1, length(data_x))
for(i in 1:pow)
x = append(x, data_x**i)
x = matrix(x, ncol = pow + 1)
y = matrix(data_y, ncol = 1)
a1 <- t(x) %*% y
a2 <- solve(t(x) %*% x)
w = t(a1) %*% a2
}
polinom <- function(data_x, data_y, pow){
x = rep(1, length(data_x))
for(i in 1:pow)
x = append(x, data_x**i)
x = matrix(x, ncol = pow + 1)
y = matrix(data_y, ncol = 1)
a1 <- t(x) %*% y
a2 <- solve(t(x) %*% x)
w = t(a1) %*% a2
}
